# ── DATABASE ──────────────────────────────────────────────────────────────────
# Neon (free): https://neon.tech → New Project → copy "Connection string"
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── AUTH ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
NEXTAUTH_SECRET="your-secret-here"

# Set to your Vercel domain after deploy (e.g. https://whoami.vercel.app)
AUTH_URL="https://your-app.vercel.app"
NEXTAUTH_URL="https://your-app.vercel.app"

# ── EMAIL (Resend) ─────────────────────────────────────────────────────────────
# https://resend.com → API Keys → Create
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Whoami <onboarding@resend.dev>"

# ── PLAID ─────────────────────────────────────────────────────────────────────
# https://dashboard.plaid.com → Team Settings → Keys
PLAID_CLIENT_ID="your-client-id"
PLAID_SANDBOX_SECRET="your-sandbox-secret"
# Use "sandbox" for testing, "production" for real accounts
PLAID_ENV="sandbox"

# ── ANTHROPIC (future AI assistant) ───────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxx"
